# Postgres connection. Neon in production (enable the pgvector extension once
# on a fresh database with `CREATE EXTENSION vector;`); local Postgres 16 with
# postgresql-16-pgvector installed in development. Same engine, same
# extension, so code paths do not change between the two.
GROUNDWORK_DATABASE_URL=postgresql+psycopg://postgres:groundwork_dev_password@localhost:5432/groundwork_dev

# Backend selection for embeddings, reranking and faithfulness scoring.
# "auto" probes huggingface.co once per process and falls back to the
# deterministic local implementation (tfidf / lexical) if it is unreachable.
# Force a specific backend by setting "local_model" or "tfidf" / "lexical".
GROUNDWORK_EMBEDDING_BACKEND=auto
GROUNDWORK_RERANK_BACKEND=auto
GROUNDWORK_FAITHFULNESS_BACKEND=auto

# Backend selection for chunk token counting. "auto" attempts the real
# tiktoken cl100k_base load once per process (itself a network fetch on
# first use) and falls back to a deterministic offline approximation if it
# cannot load. Force "tiktoken" to require the real encoding (raises loudly
# if it cannot load) or "approximate" to always use the offline counter.
GROUNDWORK_TOKENIZER_BACKEND=auto

# Optional. Generation degrades to the extractive fallback (top chunk
# verbatim plus its citation) when this is unset. Nothing else in the
# system requires it: retrieval, chunking comparison, faithfulness
# scoring and every test suite runs identically with or without it.
GROUNDWORK_LLM_API_KEY=
GROUNDWORK_LLM_MODEL=gpt-4o-mini

# Optional, used only for the secondary reply-quality score, which is
# always kept separate from the faithfulness gate. Falls back to the
# generation model's own key if unset.
GROUNDWORK_JUDGE_MODEL=

# Hard ceiling on generation spend per process lifetime, enforced before
# every LLM call, exactly as day 1.
GROUNDWORK_SPEND_CEILING_USD=2.00

# API auth for the /eval dashboard. A simple token gate, not full auth,
# because this is a demo and the README says so.
GROUNDWORK_ADMIN_TOKEN=
